APP_ENV=local
DATABASE_URL=sqlite:///./data/kkoripyo.db
CORS_ORIGINS=["http://localhost:3000"]

# 외부 데이터 API (https://everyinfra.com)
EVERYINFRA_API_KEY=
# 사진 속 글자 인식 (팀 OCR 서버). 비우면 OCR 없이 분석
OCR_SERVER_URL=https://ocr.purplecodelabs.com
# 사진 속 글자 블러 (kkoripyo-blur 서버). 비우면 블러 없이 분석
BLUR_SERVER_URL=https://blur.purplecodelabs.com
# 이 서버의 외부 주소. 가린 사진을 OCR로 다시 읽어 확실히 가려졌는지 검증 (로컬은 비워 두기)
PUBLIC_BASE_URL=
# 에이전트용 LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=high
# 진단 데모 화면(/api/v1/agent/demo)을 운영에서도 열기 (로컬은 항상 열림)
DEMO_ENABLED=false
