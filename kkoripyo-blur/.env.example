# 블러 서버 환경설정 예시. 복사해서 쓰기: cp .env.example .env
# (docker compose는 .env를 자동으로 읽고, run_linux.sh는 셸 환경변수로 넘긴다)

# 설정하면 요청에 "X-API-Key: <값>" 헤더가 필요하다. 비우면 인증 없이 열린다
API_KEY=
# 블러 API 주소·포트
HOST=0.0.0.0
PORT=8190
# 이미지 한 장당 최대 대기 시간(초)
TIMEOUT=300
# 내부 ComfyUI 포트 (127.0.0.1에서만 열림)
COMFY_PORT=8188
# Docker 빌드 시 PyTorch CUDA 빌드 (드라이버가 오래됐으면 cu128 등으로)
TORCH_INDEX=https://download.pytorch.org/whl/cu130
